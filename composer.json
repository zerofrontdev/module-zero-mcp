{
    "name": "zerofront/module-zero-mcp",
    "description": "Zero for Magento Open Source: the store as a connector in Claude (an MCP server with OAuth): the AI Assistant's tools, commands and docs from the Claude app on a phone or computer with the admin's own subscription, every change proposed and confirmed, photos from the phone.",
    "type": "magento2-module",
    "version": "1.3.9",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "mcp",
        "claude",
        "connector",
        "ai"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-email": "*",
        "magento/module-store": "*",
        "magento/module-user": "*",
        "zerofront/module-zero-ai-assistant": "^1.3.9"
    },
    "replace": {
        "fixstacks/module-zero-mcp": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\Mcp\\": ""
        }
    }
}
