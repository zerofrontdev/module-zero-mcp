    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    OAuth clients Claude registers, the authorization requests waiting for
    an admin to allow them, the one-time authorization codes, the
    tokens (a connection each: an admin user on a device), and the photo
    upload links a connection asked for.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="zero_mcp_client" resource="default" engine="innodb" comment="Zero Connect: OAuth clients">
        <column xsi:type="varchar" name="client_id" nullable="false" length="64" comment="Client ID"/>
        <column xsi:type="varchar" name="client_name" nullable="false" length="255" default="" comment="Client Name"/>
        <column xsi:type="text" name="redirect_uris" nullable="false" comment="Redirect URIs (JSON)"/>
        <column xsi:type="text" name="metadata" nullable="true" comment="Registration (JSON)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="client_id"/>
        </constraint>
    </table>
    <table name="zero_mcp_code" resource="default" engine="innodb" comment="Zero Connect: authorization codes">
        <column xsi:type="varchar" name="code_hash" nullable="false" length="64" comment="SHA-256 of the code"/>
        <column xsi:type="varchar" name="client_id" nullable="false" length="64" comment="Client ID"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="false" comment="Admin User ID"/>
        <column xsi:type="varchar" name="redirect_uri" nullable="false" length="1024" comment="Redirect URI"/>
        <column xsi:type="varchar" name="code_challenge" nullable="false" length="128" comment="PKCE challenge (S256)"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="255" default="" comment="Scope"/>
        <column xsi:type="varchar" name="resource" nullable="true" length="1024" comment="Resource"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" comment="Expires At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="code_hash"/>
        </constraint>
    </table>
    <table name="zero_mcp_pending" resource="default" engine="innodb" comment="Zero Connect: authorization requests waiting for an admin">
        <column xsi:type="int" name="pending_id" unsigned="true" nullable="false" identity="true" comment="Pending ID"/>
        <column xsi:type="varchar" name="key_hash" nullable="false" length="64" comment="SHA-256 of the browser's key"/>
        <column xsi:type="varchar" name="code_hash" nullable="false" length="64" comment="SHA-256 of the code shown"/>
        <column xsi:type="varchar" name="client_id" nullable="false" length="64" comment="Client ID"/>
        <column xsi:type="varchar" name="redirect_uri" nullable="false" length="1024" comment="Redirect URI"/>
        <column xsi:type="varchar" name="state" nullable="false" length="1024" default="" comment="Client state"/>
        <column xsi:type="varchar" name="code_challenge" nullable="false" length="128" comment="PKCE challenge (S256)"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="255" default="" comment="Scope"/>
        <column xsi:type="varchar" name="resource" nullable="true" length="1024" comment="Resource"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" comment="Expires At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="pending_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZERO_MCP_PENDING_KEY_HASH">
            <column name="key_hash"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZERO_MCP_PENDING_CODE_HASH">
            <column name="code_hash"/>
        </constraint>
    </table>
    <table name="zero_mcp_token" resource="default" engine="innodb" comment="Zero Connect: connections (tokens)">
        <column xsi:type="int" name="token_id" unsigned="true" nullable="false" identity="true" comment="Token ID"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="false" comment="Admin User ID"/>
        <column xsi:type="varchar" name="client_id" nullable="false" length="64" comment="Client ID"/>
        <column xsi:type="varchar" name="client_name" nullable="false" length="255" default="" comment="Client Name"/>
        <column xsi:type="varchar" name="access_hash" nullable="false" length="64" comment="SHA-256 of the access token"/>
        <column xsi:type="varchar" name="refresh_hash" nullable="false" length="64" comment="SHA-256 of the refresh token"/>
        <column xsi:type="varchar" name="previous_refresh_hash" nullable="true" length="64" comment="SHA-256 of the refresh token before the last rotation"/>
        <column xsi:type="timestamp" name="refreshed_at" nullable="true" comment="Last rotation at"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="255" default="" comment="Scope"/>
        <column xsi:type="int" name="conversation_id" unsigned="true" nullable="true" comment="The connection's conversation (journal)"/>
        <column xsi:type="timestamp" name="access_expires_at" nullable="false" comment="Access token expires at"/>
        <column xsi:type="timestamp" name="refresh_expires_at" nullable="false" comment="Refresh token expires at"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="last_used_at" nullable="true" comment="Last call at"/>
        <column xsi:type="varchar" name="last_action" nullable="true" length="255" comment="Last tool called"/>
        <column xsi:type="int" name="calls" unsigned="true" nullable="false" default="0" comment="Calls in all"/>
        <column xsi:type="int" name="hour_calls" unsigned="true" nullable="false" default="0" comment="Calls this hour"/>
        <column xsi:type="timestamp" name="hour_start" nullable="true" comment="The hour counted"/>
        <column xsi:type="timestamp" name="revoked_at" nullable="true" comment="Revoked At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="token_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZERO_MCP_TOKEN_ACCESS_HASH">
            <column name="access_hash"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZERO_MCP_TOKEN_REFRESH_HASH">
            <column name="refresh_hash"/>
        </constraint>
        <index referenceId="ZERO_MCP_TOKEN_PREVIOUS_REFRESH_HASH" indexType="btree">
            <column name="previous_refresh_hash"/>
        </index>
        <index referenceId="ZERO_MCP_TOKEN_USER_ID" indexType="btree">
            <column name="user_id"/>
        </index>
    </table>
    <table name="zero_mcp_draft" resource="default" engine="innodb" comment="Zero Connect: photo upload links">
        <column xsi:type="int" name="draft_id" unsigned="true" nullable="false" identity="true" comment="Draft ID"/>
        <column xsi:type="int" name="token_id" unsigned="true" nullable="false" comment="Token ID"/>
        <column xsi:type="int" name="conversation_id" unsigned="true" nullable="false" comment="Conversation ID"/>
        <column xsi:type="varchar" name="key_hash" nullable="false" length="64" comment="SHA-256 of the link's key"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" default="" comment="What the photos are of"/>
        <column xsi:type="text" name="upload_ids" nullable="true" comment="Uploads so far (JSON)"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" comment="Expires At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="draft_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZERO_MCP_DRAFT_KEY_HASH">
            <column name="key_hash"/>
        </constraint>
    </table>
</schema>
